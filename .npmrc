# Refuse to install under a Node version the project does not support, rather
# than failing later with a confusing error.
engine-strict=true

# Pin exact versions on install. A caret range means the code that ships is not
# necessarily the code that was reviewed — not an acceptable trade in a security
# tool. Dependabot handles the upgrades, so this costs nothing but review time.
save-exact=true

# Never let an install script phone home or write outside the project without
# it being a deliberate, reviewed decision.
fund=false
audit=true
